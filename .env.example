# Public Supabase client configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Canonical application URL used for metadata and local callbacks
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Private Vercel server-side secret. Must match the tracking_proxy secret
# stored in the AdBridge Supabase database. Never prefix this with NEXT_PUBLIC_.
ADBRIDGE_PROXY_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
